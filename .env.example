# ---------------------------------------------------------------
# Registros SCG — configuración para uso LOCAL
#
# COPIA este archivo y renómbralo a  .env  en la raíz del proyecto.
#   Windows (PowerShell):  copy .env.example .env
#   macOS / Linux:         cp .env.example .env
#
# Con esto es suficiente: la app guarda todo en tu equipo.
# ---------------------------------------------------------------

NODE_ENV=development

# Base de datos LOCAL en archivo (SQLite).
# La ruta es relativa a packages/web, y apunta a:
#   <raíz-del-proyecto>/datos/base-de-datos/registros.db
DATABASE_URL=file:../../datos/base-de-datos/registros.db
DATABASE_AUTH_TOKEN=

# URL que carga la app de escritorio (debe ser la web local corriendo).
WEBSITE_URL=http://localhost:4200
